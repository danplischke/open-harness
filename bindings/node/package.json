{
  "name": "@open-harness/node",
  "version": "0.1.0",
  "description": "Node/TS bindings for open-harness — the cross-harness capability core (plan, dispatch, verify) as a native addon",
  "license": "MIT",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "*.node", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bash build.sh",
    "example": "node example.mjs"
  }
}
